aws_region              = "sa-east-1"
project_name            = "sisaws"
environment             = "prod"
deploy_backend          = false
backend_image_tag       = "latest"
backend_desired_count   = 1
backend_cpu             = 512
backend_memory          = 1024
db_instance_class       = "db.t4g.micro"
use_nat_gateway         = true
enable_cloudfront       = true
db_backup_retention_days = 7

# Monitoring and cost guardrails
monthly_budget_usd         = 100
alert_email                = ""
ecs_cpu_alarm_threshold    = 75
ecs_memory_alarm_threshold = 80
rds_cpu_alarm_threshold    = 80
rds_free_storage_alarm_gib = 5

# AI Study / RAG
enable_bedrock_ai             = false
enable_bedrock_embeddings     = false
bedrock_region                 = "us-east-1"
bedrock_model_id               = "amazon.nova-lite-v1:0"
bedrock_embedding_model_id     = "amazon.titan-embed-text-v2:0"
bedrock_embedding_dimensions   = 256
