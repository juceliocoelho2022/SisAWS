aws_region               = "sa-east-1"
project_name             = "sisaws"
environment              = "dev"
deploy_backend           = false
backend_image_tag        = "latest"
backend_desired_count    = 1
backend_cpu              = 512
backend_memory           = 1024
db_instance_class        = "db.t4g.micro"
use_nat_gateway          = false
enable_cloudfront        = false
db_backup_retention_days = 1

# GitHub Actions OIDC
github_repository        = "juceliocoelho2022/SisAWS"
github_branch            = "main"
# If the account already has token.actions.githubusercontent.com configured,
# set its ARN here instead of creating another provider.
github_oidc_provider_arn = ""

# Monitoring and cost guardrails
monthly_budget_usd         = 25
alert_email                = ""
ecs_cpu_alarm_threshold    = 75
ecs_memory_alarm_threshold = 80
rds_cpu_alarm_threshold    = 80
rds_free_storage_alarm_gib = 5
